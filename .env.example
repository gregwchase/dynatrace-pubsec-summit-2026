# Copy to .env and fill in. Never commit .env.
# In Colab, add these as Secrets (key icon in the left sidebar) instead.

# Arize AX: Settings → API Keys, and the Space ID from the space settings page
# Create a user key for this workshop
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT_NAME=

# Model provider for the agent and the LLM-as-a-judge evaluators:
# openai (default) | anthropic | azure | bedrock
LLM_PROVIDER=openai

# Fill in ONLY the block for your provider.

# --- openai ---
OPENAI_API_KEY=

# --- anthropic ---
# ANTHROPIC_API_KEY=

# --- azure (Azure OpenAI) ---
# Model names below become deployment names, so deploy gpt-4.1-mini and gpt-4.1
# under those names, or set CIVIC_AGENT_MODEL / CIVIC_JUDGE_MODEL to your deployment names.
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# OPENAI_API_VERSION=2024-10-21

# --- bedrock (Amazon Bedrock) ---
# A Bedrock API key, or leave it blank to use your normal AWS credentials (~/.aws, env vars, role).
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_REGION=us-east-1

# Optional: a unique handle so your traces land in your own project (civicassist-<handle>)
WORKSHOP_PARTICIPANT=

# Optional: override models (defaults depend on the provider; see civic_agent/llm.py)
# CIVIC_AGENT_MODEL=   # the agent           (openai: gpt-4.1-mini, anthropic: claude-opus-5-5)
# CIVIC_JUDGE_MODEL=   # LLM-as-a-judge      (openai: gpt-4.1,      anthropic: claude-opus-5-5)
# CIVIC_SMALL_MODEL=   # cheaper model, Lab 3 (openai: gpt-4.1-nano, anthropic: claude-haiku-5-5)

# Optional: reuse an existing Arize AI integration for the online LLM judges
# (required for Bedrock unless you use a Bedrock API key)
# ARIZE_AI_INTEGRATION_ID=
